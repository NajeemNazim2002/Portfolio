# ---- Neon Postgres (Neon dashboard > Connect) ----
# Pooled connection string (host contains "-pooler")
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# Direct connection string (same, without "-pooler"); used by Prisma for schema changes
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# ---- Admin login (only you) ----
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="choose-a-long-password"
# Random string, 32+ characters. Generate: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# ---- Cloudinary (image uploads) ----
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ---- Public site URL (used for SEO/social previews) ----
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
