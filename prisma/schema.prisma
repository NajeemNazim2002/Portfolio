generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Category {
  GRAPHIC_DESIGN
  WEB_DEVELOPMENT
}

model Project {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  category    Category
  summary     String
  description String   @db.Text
  coverImage  String
  images      String[]
  tags        String[]
  liveUrl     String?
  repoUrl     String?
  client      String?
  year        Int?
  featured    Boolean  @default(false)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category, published])
}

model Message {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String?
  body      String   @db.Text
  createdAt DateTime @default(now())
}
